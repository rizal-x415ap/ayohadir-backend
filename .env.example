APP_NAME="Ayo Hadir"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api.ayohadir.id
FRONTEND_URL=https://ayohadir.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database (MySQL / MariaDB on cPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpanel_db_name
DB_USERNAME=cpanel_db_user
DB_PASSWORD=cpanel_db_password

# Cross-Subdomain Session Cookie for Sanctum
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.ayohadir.id
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

# Stateful domains for SPA Sanctum
SANCTUM_STATEFUL_DOMAINS=ayohadir.id,www.ayohadir.id

FILESYSTEM_DISK=public

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mail.ayohadir.id
MAIL_PORT=465
MAIL_USERNAME=no-reply@ayohadir.id
MAIL_PASSWORD=secret
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@ayohadir.id"
MAIL_FROM_NAME="${APP_NAME}"

DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENV=production
DUITKU_CALLBACK_URL=${APP_URL}/api/v1/payment/duitku/callback
DUITKU_RETURN_URL=${FRONTEND_URL}/dashboard
DUITKU_EXPIRY_PERIOD=1440
